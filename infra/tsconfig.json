{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "outDir": "cdk.out/ts",
    "types": ["node"]
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "lib/**/*.js"],
  "exclude": ["node_modules", "cdk.out"]
}
