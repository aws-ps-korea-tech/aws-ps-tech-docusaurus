{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aws-ps-korea-tech.github.io/schemas/doc-frontmatter.schema.json",
  "title": "AWS Public Sector Technical Guide front matter",
  "type": "object",
  "required": ["title", "description", "slug", "keywords", "tags", "customProps"],
  "properties": {
  "draft": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 240
    },
    "slug": {
      "type": "string",
      "pattern": "^/[a-z0-9][a-z0-9/-]*$"
    },
    "keywords": {
      "type": "array",
      "items": {"type": "string", "minLength": 2},
      "minItems": 1,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "customProps": {
      "type": "object",
      "required": [
        "contentId",
        "locale",
        "sourceLocale",
        "publicationStatus",
        "translationStatus",
        "sectors",
        "audiences",
        "contentType",
        "level",
        "awsServices",
        "maintainers",
        "lastReviewed"
      ],
      "properties": {
        "contentId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 4,
          "maxLength": 120
        },
        "locale": {
          "enum": ["ko", "en", "ja"]
        },
        "sourceLocale": {
          "enum": ["ko", "en", "ja"]
        },
        "publicationStatus": {
          "enum": ["draft", "review", "published", "archived"]
        },
        "translationStatus": {
          "enum": ["source", "current", "needs-review", "outdated"]
        },
        "translatedFrom": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "sectors": {
          "type": "array",
          "items": {
            "enum": [
              "government-public",
              "education-research",
              "healthcare-life-sciences"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "audiences": {
          "type": "array",
          "items": {
            "enum": ["customer", "partner", "builder", "researcher"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "contentType": {
          "enum": [
            "overview",
            "getting-started",
            "hands-on",
            "architecture",
            "performance-cost",
            "troubleshooting",
            "compliance",
            "reference",
            "field-note"
          ]
        },
        "level": {
          "enum": ["beginner", "intermediate", "advanced"]
        },
        "awsServices": {
          "type": "array",
          "items": {"type": "string", "minLength": 2},
          "minItems": 1,
          "uniqueItems": true
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "lastReviewed": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          ]
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "publicationStatus": {"enum": ["published", "archived"]}
            },
            "required": ["publicationStatus"]
          },
          "then": {
            "properties": {
              "lastReviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
